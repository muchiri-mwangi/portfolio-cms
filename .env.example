# Get these from your Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role key. SERVER-ONLY — never expose
# this to the browser or prefix it with NEXT_PUBLIC_. Used for order
# creation, the IntaSend webhook, and generating signed download links.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your site's public URL (used to build IntaSend redirect links).
# Use http://localhost:3000 while developing.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# From your IntaSend dashboard (Settings -> API Keys). Get sandbox keys
# first to test, then switch to live keys + INTASEND_TEST_MODE=false.
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxx
INTASEND_TEST_MODE=true

# From IntaSend dashboard -> Settings -> Webhooks. Set this same value on
# both sides so the webhook route can verify requests actually came from
# IntaSend. Webhook URL to configure there: https://your-site.vercel.app/api/webhooks/intasend
INTASEND_WEBHOOK_CHALLENGE=choose-a-random-string

# Zapier -> Webhooks by Zapier -> Catch Hook -> copy the URL here.
# Used by the contact form to trigger your Zap (e.g. send yourself an email).
ZAPIER_CONTACT_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/xxxxx/
